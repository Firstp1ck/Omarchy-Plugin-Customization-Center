{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "module-v1.json", "type": "object",
  "required": ["schemaVersion", "id", "title", "icon", "navOrder", "page", "backend", "draftSchema", "coreServices"], "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 40}, "description": {"type": "string", "maxLength": 200},
    "icon": {"type": "string"}, "navOrder": {"type": "integer", "minimum": 0},
    "page": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.qml$"},
    "backend": {"const": "backend"}, "draftSchema": {"type": "string"}, "statusSchema": {"type": "string"},
    "storedDocuments": {"type": "array", "items": {"type": "object", "required": ["kind", "schema", "location"], "additionalProperties": false,
      "properties": {"kind": {"type": "string"}, "schema": {"type": "string"}, "location": {"type": "string"}}}},
    "extraWritablePaths": {"type": "array", "items": {"type": "string"}},
    "coreServices": {"type": "array", "uniqueItems": true, "items": {"enum": ["shell_ipc", "hyprctl", "managed_block", "jsonc", "lua", "toml_writer", "drafts", "registry", "timed_confirmation", "terminal_handoff", "settings_schema", "catalog", "staging"]}},
    "queries": {"type": "array", "items": {"type": "string"}}, "hidden": {"type": "boolean", "default": false}
  }
}
