{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugins-draft-v1.json",
  "type": "object",
  "required": ["schemaVersion", "module", "baseRevision", "changes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "module": {"const": "plugins"},
    "baseRevision": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["enable", "disable", "lifecycle"]},
          "pluginId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "action": {"enum": ["add", "update", "remove", "clone"]},
          "edit": {"type": "boolean"},
          "closesCenter": {"type": "boolean"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"enum": ["enable", "disable"]}}}, "then": {"required": ["pluginId"]}},
          {"if": {"properties": {"kind": {"const": "lifecycle"}}}, "then": {"required": ["action"]}},
          {"if": {"properties": {"action": {"enum": ["update", "remove", "clone"]}}}, "then": {"required": ["pluginId"]}}
        ]
      }
    }
  }
}
