{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "bar"],
  "properties": {"schemaVersion": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60}, "bar": {"type": "object"}}
}
