{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitors status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventory",
    "cachedModes",
    "profiles",
    "active",
    "loader",
    "handwritten",
    "toggles",
    "related",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inventory": {
      "type": "object"
    },
    "cachedModes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "outputId", "identity", "modes", "observedAt", "stale"],
        "properties": {
          "profileId": {"type": "string"},
          "outputId": {"type": "string"},
          "identity": {"type": "object"},
          "modes": {"type": "array"},
          "observedAt": {"type": "string"},
          "stale": {"const": true}
        }
      }
    },
    "profiles": {
      "type": "array"
    },
    "active": {
      "type": "object"
    },
    "loader": {
      "type": "object"
    },
    "handwritten": {
      "type": "object"
    },
    "toggles": {
      "type": "object"
    },
    "related": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    }
  }
}
