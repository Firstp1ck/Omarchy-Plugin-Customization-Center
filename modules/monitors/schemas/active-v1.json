{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Active monitor profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "planDigest",
    "appliedAt",
    "rulesSha256",
    "assignments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "appliedAt": {
      "type": "string"
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "planDigest": {
      "type": "string"
    },
    "rulesSha256": {
      "type": "string"
    }
  }
}
