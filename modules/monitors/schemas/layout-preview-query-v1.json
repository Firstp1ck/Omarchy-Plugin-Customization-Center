{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitor layout preview query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rectangles",
    "bounds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rectangles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    }
  }
}
