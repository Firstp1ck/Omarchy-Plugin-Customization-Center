{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitors draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "action": {
      "enum": [
        "activate",
        "save-profile",
        "delete-profile",
        "clear-override",
        "install-loader"
      ]
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "monitor-profile-v1.json"
        }
      ]
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "override": {
      "enum": [
        "internal-monitor-disable",
        "internal-monitor-mirror"
      ]
    },
    "acknowledgedWarnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
